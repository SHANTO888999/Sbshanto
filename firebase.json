{
  "firestore": {
    "database": "ai-studio-portfoliocraft-e7b255ed-128e-4415-9cb0-dc1a4fad9447",
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "sbshanto",
      "public": "dist-viewer",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "sbadminshanto",
      "public": "dist-admin",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
