{
  "firestore": {
    "database": "ai-studio-portfoliocraft-e7b255ed-128e-4415-9cb0-dc1a4fad9447",
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "sbshanto",
      "public": "dist-viewer",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/assets/og-card.jpg",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=3600" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        }
      ]
    },
    {
      "site": "sbadminshanto",
      "public": "dist-admin",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        }
      ]
    }
  ]
}
