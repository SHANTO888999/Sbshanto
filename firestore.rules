rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.uid == '7uGlVyZQVLSofZlGXTVceJnfCg23'
          || ('email' in request.auth.token && request.auth.token.email.lower() == 'sbgang01recovery@gmail.com')
        );
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (
          isSignedIn()
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidOptionalUrl(data, field, maxLen) {
      return !(field in data) || (
        data[field] is string
        && data[field].size() <= maxLen
        && data[field].matches('^(https?://|/|mailto:).*|^$')
      );
    }

    function isValidOptionalPhone(data, field) {
      return !(field in data) || (
        data[field] is string
        && data[field].size() <= 28
        && data[field].matches('^[0-9+\\-\\s()]{3,28}$|^$')
      );
    }

    function isValidPortraitMedia(val) {
      return val is string
        && (
          val == ''
          || (val.size() >= 1 && val.size() <= 500 && val.matches('^(https?://|/).*'))
          || (val.size() >= 1 && val.size() <= 320000 && val.matches('^data:image/(png|jpeg|jpg|webp|gif);base64,.*'))
        );
    }

    function isValidOptionalProjectMedia(data, field, maxLen) {
      return !(field in data) || (
        data[field] is string
        && data[field].size() <= maxLen
        && (
          data[field] == ''
          || data[field].matches('^(https?://|/|data:(image/(png|jpeg|jpg|webp|gif)|video/(mp4|webm|quicktime|ogg));base64,).*')
        )
      );
    }

    function isValidOptionalMediaType(data) {
      return !('coverMediaType' in data)
        || (data.coverMediaType is string && data.coverMediaType in ['image', 'video']);
    }

    function isValidGalleryItem(val) {
      return val is string
        && val.size() >= 1
        && val.size() <= 165000
        && val.matches('^(https?://|/|data:image/(png|jpeg|jpg|webp|gif);base64,).*');
    }

    function isValidGalleryUrls(data) {
      return !('galleryUrls' in data) || (
        data.galleryUrls is list
        && data.galleryUrls.size() <= 5
        && (data.galleryUrls.size() < 1 || isValidGalleryItem(data.galleryUrls[0]))
        && (data.galleryUrls.size() < 2 || isValidGalleryItem(data.galleryUrls[1]))
        && (data.galleryUrls.size() < 3 || isValidGalleryItem(data.galleryUrls[2]))
        && (data.galleryUrls.size() < 4 || isValidGalleryItem(data.galleryUrls[3]))
        && (data.galleryUrls.size() < 5 || isValidGalleryItem(data.galleryUrls[4]))
      );
    }

    function isValidViewerControls(vc) {
      return vc is map
        && vc.keys().hasAll([
          'showTopScrollBar', 'showBottomHud', 'showHudProgress',
          'showHudCursors', 'showHudAutoScroll', 'showHudReplay',
          'showHudSound', 'showMultiBackBar',
          'enableCursorsByDefault', 'enableAutoScrollByDefault', 'enableSoundByDefault'
        ])
        && vc.keys().hasOnly([
          'showTopScrollBar', 'showBottomHud', 'showHudProgress',
          'showHudCursors', 'showHudAutoScroll', 'showHudReplay',
          'showHudSound', 'showMultiBackBar',
          'enableCursorsByDefault', 'enableAutoScrollByDefault', 'enableSoundByDefault',
          'cursorSpeed', 'accentColor', 'showCvDownloadOnViewer', 'showStarterDemoProjects'
        ])
        && vc.showTopScrollBar is bool
        && vc.showBottomHud is bool
        && vc.showHudProgress is bool
        && vc.showHudCursors is bool
        && vc.showHudAutoScroll is bool
        && vc.showHudReplay is bool
        && vc.showHudSound is bool
        && vc.showMultiBackBar is bool
        && vc.enableCursorsByDefault is bool
        && vc.enableAutoScrollByDefault is bool
        && vc.enableSoundByDefault is bool
        && (!('cursorSpeed' in vc) || (vc.cursorSpeed is string && vc.cursorSpeed in ['slow', 'normal', 'fast']))
        && (!('accentColor' in vc) || (vc.accentColor is string && vc.accentColor.size() == 7 && vc.accentColor.matches('^#[0-9A-Fa-f]{6}$')))
        && (!('showCvDownloadOnViewer' in vc) || vc.showCvDownloadOnViewer is bool)
        && (!('showStarterDemoProjects' in vc) || vc.showStarterDemoProjects is bool);
    }

    function isValidCvSettings(cv) {
      return cv is map
        && cv.keys().hasAll(['mode', 'customUrl', 'headline'])
        && cv.keys().hasOnly(['mode', 'customUrl', 'headline'])
        && cv.mode is string && cv.mode in ['auto', 'custom']
        && cv.headline is string && cv.headline.size() <= 100
        && cv.customUrl is string && cv.customUrl.size() <= 540000
        && (cv.customUrl == '' || cv.customUrl.matches('^(https?://|/|data:application/pdf;base64,).*'));
    }

    function isValidPortfolioSettings(data) {
      return data.keys().hasAll([
          'greeting', 'displayName', 'backdropName', 'wordmark', 'role', 'bio',
          'portraitUrl', 'email', 'githubHandle', 'githubUrl', 'availability',
          'disciplineSummary', 'craftMetricValue', 'craftMetricSuffix', 'craftMetricLabel',
          'craftSummary', 'quoteText', 'quoteAuthor', 'quoteRole',
          'manifestoLead', 'manifestoAvailability', 'prototypeTurnaround',
          'heroMetrics', 'wireframeScenes', 'techStack', 'services', 'techPartners', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'greeting', 'displayName', 'backdropName', 'wordmark', 'role', 'bio',
          'portraitUrl', 'email', 'phoneNumber', 'whatsappNumber', 'location',
          'githubHandle', 'githubUrl', 'twitterUrl', 'linkedinUrl', 'behanceUrl', 'facebookUrl', 'instagramUrl', 'availability',
          'disciplineSummary', 'craftMetricValue', 'craftMetricSuffix', 'craftMetricLabel',
          'craftSummary', 'quoteText', 'quoteAuthor', 'quoteRole',
          'manifestoLead', 'manifestoAvailability', 'prototypeTurnaround',
          'heroMetrics', 'wireframeScenes', 'techStack', 'services', 'techPartners', 'viewerControls', 'cvSettings', 'updatedAt'
        ])
        && (!('viewerControls' in data) || isValidViewerControls(data.viewerControls))
        && (!('cvSettings' in data) || isValidCvSettings(data.cvSettings))
        && data.greeting is string && data.greeting.size() <= 40
        && data.displayName is string && data.displayName.size() <= 24
        && data.backdropName is string && data.backdropName.size() <= 14
        && data.wordmark is string && data.wordmark.size() <= 20
        && data.role is string && data.role.size() <= 80
        && data.bio is string && data.bio.size() <= 300
        && isValidPortraitMedia(data.portraitUrl)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 100 && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && isValidOptionalPhone(data, 'phoneNumber')
        && isValidOptionalPhone(data, 'whatsappNumber')
        && (!('location' in data) || (data.location is string && data.location.size() <= 80))
        && data.githubHandle is string && data.githubHandle.size() <= 48
        && data.githubUrl is string && data.githubUrl.size() <= 300 && data.githubUrl.matches('^(https?://|/|mailto:).*')
        && isValidOptionalUrl(data, 'twitterUrl', 300)
        && isValidOptionalUrl(data, 'linkedinUrl', 300)
        && isValidOptionalUrl(data, 'behanceUrl', 300)
        && isValidOptionalUrl(data, 'facebookUrl', 300)
        && isValidOptionalUrl(data, 'instagramUrl', 300)
        && data.availability is string && data.availability.size() <= 48
        && data.disciplineSummary is string && data.disciplineSummary.size() <= 48
        && data.craftMetricValue is string && data.craftMetricValue.size() <= 12
        && data.craftMetricSuffix is string && data.craftMetricSuffix.size() <= 6
        && data.craftMetricLabel is string && data.craftMetricLabel.size() <= 64
        && data.craftSummary is string && data.craftSummary.size() <= 260
        && data.quoteText is string && data.quoteText.size() <= 220
        && data.quoteAuthor is string && data.quoteAuthor.size() <= 40
        && data.quoteRole is string && data.quoteRole.size() <= 80
        && data.manifestoLead is string && data.manifestoLead.size() <= 240
        && data.manifestoAvailability is string && data.manifestoAvailability.size() <= 200
        && data.prototypeTurnaround is string && data.prototypeTurnaround.size() <= 32
        && data.heroMetrics is list && data.heroMetrics.size() >= 1 && data.heroMetrics.size() <= 4
        && data.heroMetrics[0] is map
        && data.wireframeScenes is list && data.wireframeScenes.size() >= 1 && data.wireframeScenes.size() <= 6
        && data.wireframeScenes[0] is map
        && data.techStack is list && data.techStack.size() >= 1 && data.techStack.size() <= 8
        && data.techStack[0] is map
        && data.services is list && data.services.size() >= 1 && data.services.size() <= 6
        && data.services[0] is map
        && data.techPartners is list && data.techPartners.size() >= 1 && data.techPartners.size() <= 8
        && data.techPartners[0] is string
        && data.updatedAt == request.time;
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'index', 'title', 'category', 'year', 'platform', 'client', 'role',
          'stack', 'summary', 'architectureNotes', 'previewTheme', 'dimensions',
          'published', 'sortOrder', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'index', 'title', 'category', 'year', 'platform', 'client', 'role',
          'stack', 'summary', 'architectureNotes', 'previewTheme', 'dimensions',
          'coverImageUrl', 'galleryUrls', 'coverMediaType', 'liveUrl', 'repoUrl', 'published', 'sortOrder', 'updatedAt'
        ])
        && data.index is string && data.index.size() >= 1 && data.index.size() <= 8
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.category in ['Websites', 'Apps', 'Games', 'UI/UX Design']
        && data.year is string && data.year.size() >= 1 && data.year.size() <= 16
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 48
        && data.client is string && data.client.size() >= 1 && data.client.size() <= 48
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 80
        && data.stack is list && data.stack.size() >= 1 && data.stack.size() <= 6
        && data.stack[0] is string && data.stack[0].size() <= 32
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 340
        && data.architectureNotes is string && data.architectureNotes.size() >= 1 && data.architectureNotes.size() <= 360
        && data.previewTheme in ['web-commerce', 'app-workspace', 'game-rift', 'app-realtime', 'game-drift', 'ui-system']
        && data.dimensions is string && data.dimensions.size() >= 1 && data.dimensions.size() <= 24
        && isValidOptionalProjectMedia(data, 'coverImageUrl', 780000)
        && isValidGalleryUrls(data)
        && isValidOptionalMediaType(data)
        && isValidOptionalUrl(data, 'liveUrl', 300)
        && isValidOptionalUrl(data, 'repoUrl', 300)
        && data.published is bool
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000
        && data.updatedAt == request.time;
    }

    function isValidMilestone(data) {
      return data.keys().hasAll(['title', 'context', 'project', 'year', 'outcome', 'published', 'sortOrder', 'updatedAt'])
        && data.keys().hasOnly(['title', 'context', 'project', 'year', 'outcome', 'published', 'sortOrder', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 110
        && data.context is string && data.context.size() >= 1 && data.context.size() <= 64
        && data.project is string && data.project.size() >= 1 && data.project.size() <= 56
        && data.year is string && data.year.size() >= 1 && data.year.size() <= 12
        && data.outcome is string && data.outcome.size() >= 1 && data.outcome.size() <= 260
        && data.published is bool
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000
        && data.updatedAt == request.time;
    }

    function isValidExperience(data) {
      return data.keys().hasAll(['period', 'role', 'org', 'description', 'published', 'sortOrder', 'updatedAt'])
        && data.keys().hasOnly(['period', 'role', 'org', 'description', 'published', 'sortOrder', 'updatedAt'])
        && data.period is string && data.period.size() >= 1 && data.period.size() <= 32
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 80
        && data.org is string && data.org.size() >= 1 && data.org.size() <= 80
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 280
        && data.published is bool
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000
        && data.updatedAt == request.time;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'scope', 'brief', 'status', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'scope', 'brief', 'status', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120 && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.scope is string && data.scope.size() >= 1 && data.scope.size() <= 80
        && data.brief is string && data.brief.size() >= 1 && data.brief.size() <= 2000
        && data.status in ['new', 'read', 'replied', 'archived'];
    }

    match /site_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create: if isValidId(settingId) && isAdmin() && isValidPortfolioSettings(incoming());
      allow update: if isValidId(settingId) && isAdmin() && isValidPortfolioSettings(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'greeting', 'displayName', 'backdropName', 'wordmark', 'role', 'bio',
          'portraitUrl', 'email', 'phoneNumber', 'whatsappNumber', 'location',
          'githubHandle', 'githubUrl', 'twitterUrl', 'linkedinUrl', 'behanceUrl', 'facebookUrl', 'instagramUrl', 'availability',
          'disciplineSummary', 'craftMetricValue', 'craftMetricSuffix', 'craftMetricLabel',
          'craftSummary', 'quoteText', 'quoteAuthor', 'quoteRole',
          'manifestoLead', 'manifestoAvailability', 'prototypeTurnaround',
          'heroMetrics', 'wireframeScenes', 'techStack', 'services', 'techPartners', 'viewerControls', 'cvSettings', 'updatedAt'
        ]);
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (isAdmin() || existing().published == true);
      allow list: if isBootstrappedAdmin() || existing().published == true;
      allow create: if isValidId(projectId) && isAdmin() && isValidProject(incoming());
      allow update: if isValidId(projectId) && isAdmin() && isValidProject(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'index', 'title', 'category', 'year', 'platform', 'client', 'role',
          'stack', 'summary', 'architectureNotes', 'previewTheme', 'dimensions',
          'coverImageUrl', 'galleryUrls', 'coverMediaType', 'liveUrl', 'repoUrl', 'published', 'sortOrder', 'updatedAt'
        ]);
      allow delete: if isValidId(projectId) && isAdmin();
    }

    match /milestones/{milestoneId} {
      allow get: if isValidId(milestoneId) && (isAdmin() || existing().published == true);
      allow list: if isBootstrappedAdmin() || existing().published == true;
      allow create: if isValidId(milestoneId) && isAdmin() && isValidMilestone(incoming());
      allow update: if isValidId(milestoneId) && isAdmin() && isValidMilestone(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'context', 'project', 'year', 'outcome', 'published', 'sortOrder', 'updatedAt'
        ]);
      allow delete: if isValidId(milestoneId) && isAdmin();
    }

    match /experience/{experienceId} {
      allow get: if isValidId(experienceId) && (isAdmin() || existing().published == true);
      allow list: if isBootstrappedAdmin() || existing().published == true;
      allow create: if isValidId(experienceId) && isAdmin() && isValidExperience(incoming());
      allow update: if isValidId(experienceId) && isAdmin() && isValidExperience(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'period', 'role', 'org', 'description', 'published', 'sortOrder', 'updatedAt'
        ]);
      allow delete: if isValidId(experienceId) && isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming())
        && !('updatedAt' in incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time;
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow update: if isValidId(inquiryId) && isAdmin() && isValidInquiry(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    function isValidDateId(dateId) {
      return dateId is string
        && dateId.size() == 10
        && dateId.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isValidDailyAnalyticsCreate(data, dateId) {
      return data.keys().hasAll([
          'date', 'month', 'visitors', 'pageViews', 'projectClicks',
          'hireOpens', 'hireSubmits', 'cvDownloads', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'date', 'month', 'visitors', 'pageViews', 'projectClicks',
          'hireOpens', 'hireSubmits', 'cvDownloads', 'updatedAt'
        ])
        && data.date is string && data.date == dateId
        && data.month is string && data.month == dateId[0:7]
        && data.visitors is int && data.visitors >= 0 && data.visitors <= 1
        && data.pageViews is int && data.pageViews >= 0 && data.pageViews <= 1
        && data.projectClicks is int && data.projectClicks >= 0 && data.projectClicks <= 1
        && data.hireOpens is int && data.hireOpens >= 0 && data.hireOpens <= 1
        && data.hireSubmits is int && data.hireSubmits >= 0 && data.hireSubmits <= 1
        && data.cvDownloads is int && data.cvDownloads >= 0 && data.cvDownloads <= 1
        && data.updatedAt == request.time;
    }

    function isValidDailyAnalyticsUpdate(data, prev) {
      return data.keys().hasAll([
          'date', 'month', 'visitors', 'pageViews', 'projectClicks',
          'hireOpens', 'hireSubmits', 'cvDownloads', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'date', 'month', 'visitors', 'pageViews', 'projectClicks',
          'hireOpens', 'hireSubmits', 'cvDownloads', 'updatedAt'
        ])
        && data.date == prev.date
        && data.month == prev.month
        && data.visitors is int && data.visitors >= prev.visitors && data.visitors <= prev.visitors + 1
        && data.pageViews is int && data.pageViews >= prev.pageViews && data.pageViews <= prev.pageViews + 1
        && data.projectClicks is int && data.projectClicks >= prev.projectClicks && data.projectClicks <= prev.projectClicks + 1
        && data.hireOpens is int && data.hireOpens >= prev.hireOpens && data.hireOpens <= prev.hireOpens + 1
        && data.hireSubmits is int && data.hireSubmits >= prev.hireSubmits && data.hireSubmits <= prev.hireSubmits + 1
        && data.cvDownloads is int && data.cvDownloads >= prev.cvDownloads && data.cvDownloads <= prev.cvDownloads + 1
        && data.updatedAt == request.time;
    }

    function isValidProjectAnalyticsCreate(data, projectId) {
      return data.keys().hasAll(['projectId', 'title', 'category', 'clicks', 'updatedAt'])
        && data.keys().hasOnly(['projectId', 'title', 'category', 'clicks', 'updatedAt'])
        && data.projectId is string && data.projectId == projectId && data.projectId.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.category in ['Websites', 'Apps', 'Games', 'UI/UX Design']
        && data.clicks is int && data.clicks == 1
        && data.updatedAt == request.time;
    }

    function isValidProjectAnalyticsUpdate(data, prev) {
      return data.keys().hasAll(['projectId', 'title', 'category', 'clicks', 'updatedAt'])
        && data.keys().hasOnly(['projectId', 'title', 'category', 'clicks', 'updatedAt'])
        && data.projectId == prev.projectId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.category in ['Websites', 'Apps', 'Games', 'UI/UX Design']
        && data.clicks is int && data.clicks >= prev.clicks && data.clicks <= prev.clicks + 1
        && data.updatedAt == request.time;
    }

    function isValidPresence(data, sessionId) {
      return data.keys().hasAll(['sessionId', 'countryCode', 'countryName', 'path', 'lastSeenAt'])
        && data.keys().hasOnly(['sessionId', 'countryCode', 'countryName', 'path', 'lastSeenAt'])
        && data.sessionId is string && data.sessionId == sessionId && data.sessionId.size() <= 80
        && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 8 && data.countryCode.matches('^[A-Z0-9_\\-]+$')
        && data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 60
        && data.path is string && data.path.size() >= 1 && data.path.size() <= 64
        && data.lastSeenAt == request.time;
    }

    function isValidDemographicCreate(data, bucketId) {
      return data.keys().hasAll(['bucketId', 'bucketType', 'code', 'label', 'count', 'updatedAt'])
        && data.keys().hasOnly(['bucketId', 'bucketType', 'code', 'label', 'count', 'updatedAt'])
        && data.bucketId is string && data.bucketId == bucketId && data.bucketId.size() <= 48
        && data.bucketType in ['country', 'age']
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 24
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 60
        && data.count is int && data.count == 1
        && data.updatedAt == request.time;
    }

    function isValidDemographicUpdate(data, prev) {
      return data.keys().hasAll(['bucketId', 'bucketType', 'code', 'label', 'count', 'updatedAt'])
        && data.keys().hasOnly(['bucketId', 'bucketType', 'code', 'label', 'count', 'updatedAt'])
        && data.bucketId == prev.bucketId
        && data.bucketType == prev.bucketType
        && data.code == prev.code
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 60
        && data.count is int && data.count >= prev.count && data.count <= prev.count + 1
        && data.updatedAt == request.time;
    }

    match /analytics_daily/{dateId} {
      allow get: if isValidDateId(dateId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidDateId(dateId) && isValidDailyAnalyticsCreate(incoming(), dateId);
      allow update: if isValidDateId(dateId)
        && isValidDailyAnalyticsUpdate(incoming(), existing())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'visitors', 'pageViews', 'projectClicks', 'hireOpens', 'hireSubmits', 'cvDownloads', 'updatedAt'
        ]);
      allow delete: if isValidDateId(dateId) && isAdmin();
    }

    match /analytics_projects/{projectId} {
      allow get: if isValidId(projectId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(projectId) && isValidProjectAnalyticsCreate(incoming(), projectId);
      allow update: if isValidId(projectId)
        && isValidProjectAnalyticsUpdate(incoming(), existing())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'clicks', 'updatedAt'
        ]);
      allow delete: if isValidId(projectId) && isAdmin();
    }

    match /analytics_presence/{sessionId} {
      allow get: if isValidId(sessionId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(sessionId) && isValidPresence(incoming(), sessionId);
      allow update: if isValidId(sessionId)
        && isValidPresence(incoming(), sessionId)
        && incoming().sessionId == existing().sessionId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'countryCode', 'countryName', 'path', 'lastSeenAt'
        ]);
      allow delete: if isValidId(sessionId) && isAdmin();
    }

    match /analytics_demographics/{bucketId} {
      allow get: if isValidId(bucketId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(bucketId) && isValidDemographicCreate(incoming(), bucketId);
      allow update: if isValidId(bucketId)
        && isValidDemographicUpdate(incoming(), existing())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'label', 'count', 'updatedAt'
        ]);
      allow delete: if isValidId(bucketId) && isAdmin();
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }
  }
}
